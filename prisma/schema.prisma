// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  favorites Favorite[]  // um usuário pode ter várias linhas de favorito
}

model Poem {
  id         String     @id @default(uuid())
  title      String
  author     String
  sourceApi  String     // de onde veio (PoetryDB, Domínio Público, etc.)
  favorites  Favorite[]  // um poema pode estar em vários favoritos
}

model Favorite {
  id       String   @id @default(uuid())
  userId   String
  poemId   String
  user     User     @relation(fields: [userId], references: [id])
  poem     Poem     @relation(fields: [poemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, poemId]) // evita favoritar o mesmo poema duas vezes
}